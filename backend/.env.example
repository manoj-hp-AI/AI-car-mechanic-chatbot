# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.amazonaws.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Database (SQLite file path; default is fine for local/dev)
SQLITE_DB_PATH=db.sqlite3

# CORS - the deployed Vercel frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Uploads
MAX_UPLOAD_SIZE_MB=25

# Gemini - leave blank to run in backend-only mode (no AI calls at all)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

LOG_LEVEL=INFO
